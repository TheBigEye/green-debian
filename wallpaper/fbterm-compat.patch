diff -ruN '--exclude=Makefile.in' a/src/kittykey.cpp b/src/kittykey.cpp
--- a/src/kittykey.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/kittykey.cpp	2026-11-20 02:12:31.740347992 +0000
@@ -0,0 +1,648 @@
+/*
+ *   kittykey.cpp - kitty keyboard protocol encoder (see kittykey.h).
+ *
+ *   The translation mirrors the Linux VT keyboard driver
+ *   (drivers/tty/vt/keyboard.c): modifier state is tracked from
+ *   KT_SHIFT keysyms, the effective keysym is looked up in the
+ *   kernel keymap for that state, dead keys keep a pending
+ *   diacritic combined through the kernel accent table, and
+ *   CapsLock/NumLock are toggles.
+ *
+ *   Alt+keypad numeric composition (KT_ASCII) is reproduced,
+ *   including the AltGr hexadecimal variant.
+ *
+ *   Not reproduced (documented losses in kitty mode):
+ *   - Braille keys (KT_BRL), sticky slock composition details
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <linux/keyboard.h>
+#include <linux/input.h>
+#include "kittykey.h"
+#include "input_key.h" // AC_START / AC_END (FbTerm system keys)
+
+#define BIT(x) (1 << (x))
+
+#ifndef KT_CSI
+#define KT_CSI 15 // keymap CSI keys (type number from drivers/tty/vt/vt.h)
+#endif
+
+static u32 putUtf8(char *out, u32 cp)
+{
+	if (cp < 0x80) {
+		out[0] = (char)cp;
+		return 1;
+	}
+	if (cp < 0x800) {
+		out[0] = (char)(0xc0 | (cp >> 6));
+		out[1] = (char)(0x80 | (cp & 0x3f));
+		return 2;
+	}
+	if (cp < 0x10000) {
+		out[0] = (char)(0xe0 | (cp >> 12));
+		out[1] = (char)(0x80 | ((cp >> 6) & 0x3f));
+		out[2] = (char)(0x80 | (cp & 0x3f));
+		return 3;
+	}
+	out[0] = (char)(0xf0 | (cp >> 18));
+	out[1] = (char)(0x80 | ((cp >> 12) & 0x3f));
+	out[2] = (char)(0x80 | ((cp >> 6) & 0x3f));
+	out[3] = (char)(0x80 | (cp & 0x3f));
+	return 4;
+}
+
+// CSI key[:alternate] [; modifiers[:event]] [; text] u
+// mods < 0 means "no modifiers", which is encoded by omitting the field.
+static u32 csiU(char *out, u32 size, u32 key, u32 alt, u32 text, int mods, int evt)
+{
+	int n;
+	if (alt)
+		n = snprintf(out, size, "\x1b[%u:%u", key, alt);
+	else
+		n = snprintf(out, size, "\x1b[%u", key);
+	if (mods >= 0 || evt || text) { // modifiers field must be present
+		                        // when a text field follows
+		n += snprintf(out + n, size - n, ";%d", mods >= 0 ? mods : 1);
+		if (evt) n += snprintf(out + n, size - n, ":%d", evt);
+	}
+	if (text) n += snprintf(out + n, size - n, ";%u", text);
+	n += snprintf(out + n, size - n, "u");
+	return (u32)n;
+}
+
+// CSI [1;] modifiers[:event] letter   (arrows, Home/End, F1-F4)
+static u32 csiLetter(char *out, u32 size, char letter, int mods, int evt)
+{
+	if (mods < 0 && !evt) return snprintf(out, size, "\x1b[%c", letter);
+	int n = snprintf(out, size, "\x1b[1;%d", mods >= 0 ? mods : 1);
+	if (evt) n += snprintf(out + n, size - n, ":%d", evt);
+	n += snprintf(out + n, size - n, "%c", letter);
+	return (u32)n;
+}
+
+// CSI number [; modifiers[:event]] ~
+static u32 csiTilde(char *out, u32 size, u32 num, int mods, int evt)
+{
+	int n = snprintf(out, size, "\x1b[%u", num);
+	if (mods >= 0 || evt) {
+		n += snprintf(out + n, size - n, ";%d", mods >= 0 ? mods : 1);
+		if (evt) n += snprintf(out + n, size - n, ":%d", evt);
+	}
+	n += snprintf(out + n, size - n, "~");
+	return (u32)n;
+}
+
+void KittyEncoder::reset()
+{
+	mFlags = 0;
+	mCursorApp = mKeypadApp = false;
+	mCaps = mNum = false;
+	mLockChanged = false;
+	memset(mDown, 0, sizeof(mDown));
+	memset(mShiftDown, 0, sizeof(mShiftDown));
+	mShiftState = 0;
+	mDiacr = 0;
+	mComposeNext = false;
+	mAsciiActive = false;
+	mAsciiValue = 0;
+	mSyskey = mVc = 0;
+}
+
+int KittyEncoder::kittyMods(bool locks) const
+{
+	int m = 0;
+	if (mShiftState & (BIT(KG_SHIFT) | BIT(KG_SHIFTL) | BIT(KG_SHIFTR) | BIT(KG_CAPSSHIFT))) m |= 1;
+	if (mShiftState & BIT(KG_ALT)) m |= 2;
+	if (mShiftState & (BIT(KG_CTRL) | BIT(KG_CTRLL) | BIT(KG_CTRLR))) m |= 4;
+	if (locks) {
+		if (mCaps) m |= 64;
+		if (mNum) m |= 128;
+	}
+	return m;
+}
+
+// Decode one KDGKBENT result. The ioctl returns the stored keysym
+// XORed with 0xf000 (the kernel's U() macro), so KT_* keysyms come
+// back as plain K(type, value) (< 0x1000) and unicode codepoints
+// >= 0x100 come back XORed with 0xf000. KT_LETTER entries are
+// characters too (their value is the codepoint).
+static bool decodeKeysym(u16 keysym, u32 &type, u32 &value, u32 &ch)
+{
+	if (!keysym) return false;
+	if ((keysym >> 8) < 16) {
+		type = keysym >> 8;
+		value = keysym & 0xff;
+		if (type == KT_LATIN || type == KT_LETTER) {
+			ch = value;
+			return true;
+		}
+		return false;
+	}
+	type = KT_LATIN;
+	value = ch = keysym ^ 0xf000;
+	return true;
+}
+
+static bool charKeysym(u16 keysym, u32 &ch)
+{
+	u32 type, value;
+	return decodeKeysym(keysym, type, value, ch);
+}
+
+bool KittyEncoder::lookupChar(u8 table, u16 code, u32 &ch)
+{
+	u16 ks;
+	if (!mKm->lookup(table, code, ks)) return false;
+	return charKeysym(ks, ch);
+}
+
+// Emit the character composed with Alt+keypad digits. The kernel
+// flushes the composition when a shift key release changes the shift
+// state; it sends the raw codepoint (to_utf8), bypassing any pending
+// diacritic, which stays pending like in the kernel.
+u32 KittyEncoder::flushAscii(char *out, u32 size)
+{
+	mAsciiActive = false;
+	u32 v = mAsciiValue;
+	mAsciiValue = 0;
+	if (v >= 0xd800 && v < 0xe000) return 0; // surrogates: dropped
+	if (v == 0xffff || v >= 0x110000) return 0;
+	if (mFlags & 8) // report-all: key event with the composed text
+		return csiU(out, size, v, 0, (mFlags & 16) ? v : 0, -1, 0);
+	return putUtf8(out, v);
+}
+
+u32 KittyEncoder::combineDiacr(u32 c, char *out)
+{
+	u32 d = mDiacr, res;
+	mDiacr = 0;
+	if (mKm->accent(d, c, res)) return putUtf8(out, res);
+	if (c == ' ' || c == d) return putUtf8(out, d);
+	u32 n = putUtf8(out, d);
+	return n + putUtf8(out + n, c);
+}
+
+// ---------------------------------------------------------------------------
+// One function-key style event (arrows/F/nav/pad-nav and CSI-u codes),
+// with the kitty rules for press/repeat/release reporting.
+struct KeyForm {
+	enum Kind { Letter, Tilde, UCode, Ss3 } kind;
+	u32 num;     // tilde number / CSI-u code
+	char letter; // letter final
+};
+
+u32 KittyEncoder::feed(u16 code, bool down, char *out, u32 outSize)
+{
+	if (code >= 128 || !outSize) return 0;
+
+	bool rep = down && mDown[code];
+	mDown[code] = down;
+
+	u16 raw = 0;
+	mKm->lookup((u8)mShiftState, code, raw);
+
+	// Normalise like the kernel: values below 0xf000 are unicode
+	// codepoints, above they are K(KT_*, value) keysyms.
+	bool isChar = false;
+	u32 ch = 0, type = KT_LATIN, value = 0;
+	if (raw) isChar = decodeKeysym(raw, type, value, ch);
+	else return 0;
+
+	// A hole in a modified table: the kernel falls back to the plain
+	// map for the modifier-aware KT_CUR / KT_CSI key types.
+	if (!isChar && type == KT_SPEC && value == 0 && mShiftState) {
+		u16 plain = 0;
+		if (mKm->lookup(0, code, plain) && plain) {
+			u32 t2, v2, c2;
+			bool ic2 = decodeKeysym(plain, t2, v2, c2);
+			if (!ic2 && (t2 == KT_CUR || t2 == KT_CSI)) {
+				type = t2;
+				value = v2;
+			}
+		}
+	}
+
+	bool shift = (mShiftState & (BIT(KG_SHIFT) | BIT(KG_SHIFTL) | BIT(KG_SHIFTR) | BIT(KG_CAPSSHIFT))) != 0;
+	bool ctrl = (mShiftState & (BIT(KG_CTRL) | BIT(KG_CTRLL) | BIT(KG_CTRLR))) != 0;
+	bool alt = (mShiftState & BIT(KG_ALT)) != 0;
+	int evt = down ? ((rep && (mFlags & 2)) ? 2 : 0) : 3;
+	int mods = kittyMods(true);
+	bool dis = (mFlags & 9) != 0; // flag 8 implies flag 1
+	int modsParam = mods ? 1 + mods : -1;
+
+	// Helper for the functional forms (not for text keys).
+	auto emitForm = [&](const KeyForm &f, bool noReleaseWithoutAll) -> u32 {
+		if (!down && !(mFlags & 2)) return 0;
+		if (!down && noReleaseWithoutAll && !(mFlags & 8)) return 0;
+		int e = down ? evt : 3;
+		switch (f.kind) {
+		case KeyForm::Ss3:
+			if (e) // SS3 has no encoding for events; use CSI form
+				return csiLetter(out, outSize, f.letter, modsParam, e);
+			out[0] = 0x1b; out[1] = 'O'; out[2] = f.letter;
+			return 3;
+		case KeyForm::Letter:
+			return csiLetter(out, outSize, f.letter, modsParam, e);
+		case KeyForm::Tilde:
+			return csiTilde(out, outSize, f.num, modsParam, e);
+		default:
+			return csiU(out, outSize, f.num, 0, 0, modsParam, e);
+		}
+	};
+
+	if (!isChar) {
+		switch (type) {
+		case KT_SHIFT:
+		case KT_SLOCK: {
+			if (value >= 16) return 0;
+			u32 v = value;
+			u16 oldState = mShiftState;
+			if (!rep) {
+				if (v == KG_CAPSSHIFT) {
+					if (down && mCaps) {
+						mCaps = false;
+						mLockChanged = true;
+					}
+					v = KG_SHIFT;
+				}
+				if (down) mShiftDown[v]++;
+				else if (mShiftDown[v]) mShiftDown[v]--;
+				if (mShiftDown[v]) mShiftState |= (1 << v);
+				else mShiftState &= ~(1 << v);
+			}
+			// Alt+keypad composition flushes when a shift release
+			// changes the shift state, exactly like the kernel.
+			u32 flushed = 0;
+			if (!down && mShiftState != oldState && mAsciiActive)
+				flushed = flushAscii(out, outSize);
+			if (type != KT_SHIFT || !(mFlags & 8)) return flushed;
+			if (!down && !(mFlags & 2)) return flushed;
+			u32 kc = 0;
+			switch (code) {
+			case KEY_LEFTSHIFT: kc = 57441; break;
+			case KEY_RIGHTSHIFT: kc = 57447; break;
+			case KEY_LEFTCTRL: kc = 57442; break;
+			case KEY_RIGHTCTRL: kc = 57448; break;
+			case KEY_LEFTALT: kc = 57443; break;
+			case KEY_RIGHTALT: kc = (value == KG_ALTGR) ? 57453 : 57449; break;
+			case KEY_LEFTMETA: kc = 57444; break;
+			case KEY_RIGHTMETA: kc = 57450; break;
+			default: break;
+			}
+			if (!kc) return flushed;
+			int m2 = kittyMods(true);
+			return flushed + csiU(out + flushed, outSize - flushed, kc, 0, 0,
+					      m2 ? 1 + m2 : -1, down ? evt : 3);
+		}
+
+		case KT_LOCK:
+			if (down && !rep && value == KG_CAPSSHIFT) {
+				mCaps = !mCaps;
+				mLockChanged = true;
+			}
+			if ((mFlags & 8) && value == KG_CAPSSHIFT)
+				return emitForm(KeyForm{KeyForm::UCode, 57358, 0}, false);
+			return 0;
+
+		case KT_CONS:
+			if (down && !rep) mVc = (u16)(value + 1);
+			return 0;
+
+		case KT_SPEC:
+			switch (value) {
+			case 1: { // fn_enter
+				if (!down) {
+					if ((mFlags & 2) && (mFlags & 8))
+						return csiU(out, outSize, 13, 0, 0, modsParam, 3);
+					return 0;
+				}
+				int m = (shift ? 1 : 0) | (alt ? 2 : 0) | (ctrl ? 4 : 0);
+				if (!m) {
+					out[0] = '\r';
+					return 1;
+				}
+				if (alt && !shift && !ctrl) {
+					out[0] = 0x1b; out[1] = '\r';
+					return 2;
+				}
+				if (dis)
+					return csiU(out, outSize, 13, 0, 0, modsParam, evt);
+				out[0] = '\r';
+				return 1;
+			}
+			case 7: // fn_caps_toggle
+			case 13: // fn_caps_on
+				if (down && !rep) {
+					mCaps = (value == 13) ? true : !mCaps;
+					mLockChanged = true;
+				}
+				if (mFlags & 8)
+					return emitForm(KeyForm{KeyForm::UCode, 57358, 0}, false);
+				return 0;
+			case 8: // fn_num
+				if (down && !rep) {
+					mNum = !mNum;
+					mLockChanged = true;
+				}
+				if (mFlags & 8)
+					return emitForm(KeyForm{KeyForm::UCode, 57360, 0}, false);
+				return 0;
+			case 14: // fn_compose
+				if (down) mComposeNext = true;
+				return 0;
+			default:
+				return 0;
+			}
+
+		case KT_DEAD: {
+			static const u8 retDiacr[27] = {
+				'`', '\'', '^', '~', '"', ',', '_', 'U', '.', '*', '=',
+				'c', 'k', 'i', '#', 'o', '!', '?', '+', '-', ')', '(',
+				':', 'n', ';', '$', '@'
+			};
+			if (!down || value >= 27) return 0;
+			u32 dc = retDiacr[value];
+			if (!mDiacr) {
+				mDiacr = dc;
+				return 0;
+			}
+			u32 res;
+			if (mKm->accent(mDiacr, dc, res)) {
+				mDiacr = res;
+				return 0;
+			}
+			u32 n = putUtf8(out, mDiacr);
+			mDiacr = dc;
+			return n;
+		}
+
+		case KT_DEAD2:
+			if (down) {
+				if (!mDiacr) {
+					mDiacr = value;
+					return 0;
+				}
+				u32 res;
+				if (mKm->accent(mDiacr, value, res)) {
+					mDiacr = res;
+					return 0;
+				}
+				u32 n = putUtf8(out, mDiacr);
+				mDiacr = value;
+				return n;
+			}
+			return 0;
+
+		case KT_CUR: {
+			static const char curChars[4] = { 'B', 'D', 'C', 'A' }; // down left right up
+			if (value >= 4) return 0;
+			if (mCursorApp && !mods && down && !evt) {
+				out[0] = 0x1b; out[1] = 'O'; out[2] = curChars[value];
+				return 3;
+			}
+			return emitForm(KeyForm{KeyForm::Letter, 0, curChars[value]}, false);
+		}
+
+		case KT_FN: {
+			static const u32 fTilde[8] = { 15, 17, 18, 19, 20, 21, 23, 24 }; // F5..F12
+			if (value <= 3) { // F1..F4
+				static const char fLetters[4] = { 'P', 'Q', 'R', 'S' };
+				if (!mods && down && !evt) {
+					out[0] = 0x1b; out[1] = 'O'; out[2] = fLetters[value];
+					return 3;
+				}
+				return emitForm(KeyForm{KeyForm::Letter, 0, fLetters[value]}, false);
+			}
+			if (value >= 4 && value <= 11)
+				return emitForm(KeyForm{KeyForm::Tilde, fTilde[value - 4], 0}, false);
+			if (value >= 12 && value <= 19) { // F13..F20
+				static const u32 f13Tilde[8] = { 25, 26, 28, 29, 31, 32, 33, 34 };
+				if (dis)
+					return emitForm(KeyForm{KeyForm::UCode, 57376 + (value - 12), 0}, false);
+				return emitForm(KeyForm{KeyForm::Tilde, f13Tilde[value - 12], 0}, false);
+			}
+			switch (value) {
+			case 20: return emitForm(KeyForm{KeyForm::Letter, 0, 'H'}, false); // FIND = Home
+			case 21: return emitForm(KeyForm{KeyForm::Tilde, 2, 0}, false);    // INSERT
+			case 22: return emitForm(KeyForm{KeyForm::Tilde, 3, 0}, false);    // REMOVE = Delete
+			case 23: return emitForm(KeyForm{KeyForm::Letter, 0, 'F'}, false); // SELECT = End
+			case 24: return emitForm(KeyForm{KeyForm::Tilde, 5, 0}, false);    // PGUP
+			case 25: return emitForm(KeyForm{KeyForm::Tilde, 6, 0}, false);    // PGDN
+			case 29: return emitForm(KeyForm{KeyForm::UCode, 57362, 0}, false); // PAUSE
+			default: return 0;
+			}
+		}
+
+		case KT_PAD: {
+			static const char padChars[] = "0123456789+-*/\015,.?()#";
+			if (value > 20) return 0;
+			if (!mNum) {
+				switch (value) {
+				case 16: return emitForm(KeyForm{KeyForm::Tilde, 3, 0}, false);    // PDOT -> Delete
+				case 0: return emitForm(KeyForm{KeyForm::Tilde, 2, 0}, false);     // P0 -> Insert
+				case 1: return emitForm(KeyForm{KeyForm::Letter, 0, 'F'}, false);  // P1 -> End
+				case 2: return emitForm(KeyForm{KeyForm::Letter, 0, 'B'}, false);  // P2 -> Down
+				case 3: return emitForm(KeyForm{KeyForm::Tilde, 6, 0}, false);     // P3 -> PgDn
+				case 4: return emitForm(KeyForm{KeyForm::Letter, 0, 'D'}, false);  // P4 -> Left
+				case 6: return emitForm(KeyForm{KeyForm::Letter, 0, 'C'}, false);  // P6 -> Right
+				case 7: return emitForm(KeyForm{KeyForm::Letter, 0, 'H'}, false);  // P7 -> Home
+				case 8: return emitForm(KeyForm{KeyForm::Letter, 0, 'A'}, false);  // P8 -> Up
+				case 9: return emitForm(KeyForm{KeyForm::Tilde, 5, 0}, false);     // P9 -> PgUp
+				case 5: return emitForm(KeyForm{KeyForm::Letter, 0, 'E'}, false);  // P5 -> Begin
+				default: break;
+				}
+			}
+			if (value == 14) { // KP enter behaves like Enter
+				if (!down) {
+					if ((mFlags & 2) && (mFlags & 8))
+						return csiU(out, outSize, 57414, 0, 0, modsParam, 3);
+					return 0;
+				}
+				out[0] = '\r';
+				return 1;
+			}
+			if (!down && !(mFlags & 2)) return 0;
+			if (mFlags & 8) {
+				u32 kc = 0;
+				if (value <= 9) kc = 57399 + value;
+				else if (value == 15 || value == 16) kc = 57409;
+				else if (value == 13) kc = 57410;
+				else if (value == 12) kc = 57411;
+				else if (value == 11) kc = 57412;
+				else if (value == 10) kc = 57413;
+				if (kc) return csiU(out, outSize, kc, 0, 0, modsParam, down ? evt : 3);
+			}
+			if (!down) return 0;
+			return putUtf8(out, (u32)(u8)padChars[value]);
+		}
+
+		case KT_META: // Meta (Alt) + char in old keymaps
+			if (!down) return 0;
+			if (dis) {
+				int m2 = kittyMods(true) | 2;
+				return csiU(out, outSize, value, 0, 0, 1 + m2, evt);
+			}
+			out[0] = 0x1b;
+			out[1] = (char)value;
+			return 2;
+
+		case KT_CSI: { // the keymap itself asks for CSI <value> [;mod] ~
+			if (!down) return 0;
+			int mod = 1 + (shift ? 1 : 0) + (alt ? 2 : 0) + (ctrl ? 4 : 0);
+			if (mod > 1)
+				return snprintf(out, outSize, "\x1b[%u;%d~", value, mod);
+			return snprintf(out, outSize, "\x1b[%u~", value);
+		}
+
+		case KT_ASCII: // Alt+keypad digits compose a codepoint
+			if (!down || value >= 26) return 0;
+			if (!mAsciiActive) {
+				mAsciiActive = true;
+				mAsciiValue = 0;
+			}
+			if (value < 10) // while Alt held: decimal
+				mAsciiValue = mAsciiValue * 10 + value;
+			else // while AltGr held: hexadecimal
+				mAsciiValue = mAsciiValue * 16 + (value - 10);
+			return 0;
+
+		default: // KT_BRL and unknowns
+			return 0;
+		}
+	}
+
+	// ------------------------------------------------------------------
+	// Character keys (KT_LATIN / KT_LETTER, or plain unicode keysyms).
+	// CapsLock acts on letters by re-looking-up with shift toggled,
+	// exactly like the kernel.
+	if (type == KT_LETTER && mCaps) {
+		u32 ch2;
+		if (lookupChar((u8)(mShiftState ^ BIT(KG_SHIFT)), code, ch2)) ch = ch2;
+	}
+
+	// FbTerm system keys live in the keymap as latin 0x80.. values.
+	if (down && ch >= (u32)AC_START && ch <= (u32)AC_END) {
+		mSyskey = (u16)ch;
+		return 0;
+	}
+
+	u32 base = ch, shiftedSym = 0;
+	lookupChar(0, code, base);
+	bool hasShifted = lookupChar(BIT(KG_SHIFT), code, shiftedSym);
+	u32 altField = ((mFlags & 4) && shift && hasShifted && shiftedSym != base && shiftedSym >= 0x20)
+		? shiftedSym : 0;
+
+	if (!down) { // releases only in report-all mode
+		if (!(mFlags & 2) || !(mFlags & 8)) return 0;
+		if (base < 0x20 && base != 27 && base != 9) return 0;
+		u32 key = base >= 0x20 || base == 27 || base == 9 ? base : ch;
+		if (key == 0x7f) key = 127;
+		return csiU(out, outSize, key, altField, 0, modsParam, 3);
+	}
+
+	char *p = out;
+
+	// fn_compose: the next character becomes the pending diacritic.
+	if (mComposeNext) {
+		mComposeNext = false;
+		if (ch) mDiacr = ch;
+		return 0;
+	}
+
+	int plainMods = (shift ? 1 : 0) | (alt ? 2 : 0) | (ctrl ? 4 : 0);
+
+	// The Escape key itself.
+	if (base == 27 && ch == 27) {
+		if (dis)
+			return csiU(out, outSize, 27, 0, 0, mods ? modsParam : -1, evt);
+		out[0] = 0x1b;
+		return 1;
+	}
+
+	// Tab key.
+	if (base == 9 && ch <= 9) {
+		if (!plainMods) {
+			out[0] = '\t';
+			return 1;
+		}
+		if (plainMods == 1 && !dis) { // shift+tab, legacy form
+			memcpy(out, "\x1b[Z", 3);
+			return 3;
+		}
+		if (dis)
+			return csiU(out, outSize, 9, 0, 0, modsParam, evt);
+		if (alt && !ctrl) {
+			out[0] = 0x1b; out[1] = '\t';
+			return 2;
+		}
+		out[0] = '\t';
+		return 1;
+	}
+
+	// Backspace key.
+	if (base == 0x7f && ch <= 0x7f) {
+		if (dis && plainMods && plainMods != 2 && plainMods != 4 &&
+		    plainMods != 6 && plainMods != 1)
+			return csiU(out, outSize, 127, 0, 0, modsParam, evt);
+		switch (plainMods) {
+		case 0: case 1: out[0] = 0x7f; return 1;
+		case 4: case 5: out[0] = 0x08; return 1;
+		case 2: case 3: out[0] = 0x1b; out[1] = 0x7f; return 2;
+		default: out[0] = 0x1b; out[1] = 0x08; return 2; // ctrl+alt
+		}
+	}
+
+	bool textKey = (ch >= 0x20 && ch != 0x7f);
+
+	if (textKey) {
+		if (mDiacr) {
+			if (!(ctrl ^ alt)) return combineDiacr(ch, out);
+			// an encoded/legacy key follows: the diacritic stands alone
+			p += putUtf8(p, mDiacr);
+			mDiacr = 0;
+		}
+		if (!(ctrl ^ alt)) {
+			// plain, shift, AltGr or Ctrl+Alt (AltGr-equivalent):
+			// the keymap result is text
+			if (mFlags & 8) {
+				u32 text = (mFlags & 16) ? ch : 0;
+				return (u32)(p - out) + csiU(p, outSize - (p - out), base, altField, text, modsParam, evt);
+			}
+			return (u32)(p - out) + putUtf8(p, ch);
+		}
+		if (!dis) { // legacy bytes
+			if (alt) {
+				*p++ = 0x1b;
+				return (u32)(p - out) + putUtf8(p, ch);
+			}
+			*p++ = (char)ch; // the ctrl-table result is already the byte
+			return (u32)(p - out);
+		}
+		u32 text = ((mFlags & 16) && (mFlags & 8)) ? ch : 0;
+		return (u32)(p - out) + csiU(p, outSize - (p - out), base >= 0x20 ? base : ch,
+					     altField, text, modsParam, evt);
+	}
+
+	// Control results (Ctrl+letter and friends): ch is the byte the
+	// kernel would have produced.
+	if (ctrl || alt) {
+		if (!dis) {
+			if (alt && !ctrl) {
+				*p++ = 0x1b;
+				*p++ = (char)ch;
+				return (u32)(p - out);
+			}
+			*p++ = (char)ch;
+			return (u32)(p - out);
+		}
+		return (u32)(p - out) + csiU(p, outSize - (p - out), base >= 0x20 ? base : ch,
+					     altField, 0, modsParam, evt);
+	}
+
+	if (ch) { // a control code with no modifiers: send it as-is
+		out[0] = (char)ch;
+		return 1;
+	}
+	return 0;
+}
diff -ruN '--exclude=Makefile.in' a/src/kittykey.h b/src/kittykey.h
--- a/src/kittykey.h	1970-01-01 00:00:00.000000000 +0000
+++ b/src/kittykey.h	2026-11-20 02:12:31.740347992 +0000
@@ -0,0 +1,75 @@
+/*
+ *   kittykey.h - kitty keyboard protocol encoder for FbTerm.
+ *
+ *   Translates console scancodes (K_MEDIUMRAW) into the byte stream
+ *   expected by an application that requested the kitty keyboard
+ *   protocol (CSI > / = ... u). Key identity and text come from the
+ *   kernel keymap (KDGKBENT), so the user's console layout - dead
+ *   keys included, via the kernel accent table - keeps working.
+ *
+ *   The keymap is injected through KittyKeymap so the encoder can
+ *   be unit-tested without a console.
+ */
+
+#ifndef KITTYKEY_H
+#define KITTYKEY_H
+
+#include "type.h"
+
+struct KittyKeymap {
+	virtual ~KittyKeymap() {}
+	// Raw keymap entry (kernel format), false if the ioctl failed.
+	virtual bool lookup(u8 table, u16 code, u16 &keysym) = 0;
+	// Kernel accent table (KDGKBDIACRUC): combine diacritic + base.
+	virtual bool accent(u32 diacr, u32 base, u32 &result) = 0;
+};
+
+class KittyEncoder {
+public:
+	explicit KittyEncoder(KittyKeymap *km) : mKm(km) { reset(); }
+
+	void reset();
+	// Called by the glue before each input batch.
+	void setModes(u8 flags, bool cursorApp, bool keypadApp)
+	{
+		mFlags = flags;
+		mCursorApp = cursorApp;
+		mKeypadApp = keypadApp;
+	}
+	void setLocks(bool caps, bool num) { mCaps = caps; mNum = num; }
+	bool capsLock() const { return mCaps; }
+	bool numLock() const { return mNum; }
+	bool consumeLockChanged()
+	{
+		bool c = mLockChanged;
+		mLockChanged = false;
+		return c;
+	}
+
+	// Feed one scancode event. Returns output length (0 = nothing).
+	// Side channels for the glue: takeSyskey() / takeVc().
+	u32 feed(u16 code, bool down, char *out, u32 outSize);
+	u16 takeSyskey() { u16 v = mSyskey; mSyskey = 0; return v; }
+	u16 takeVc() { u16 v = mVc; mVc = 0; return v; }
+
+private:
+	KittyKeymap *mKm;
+	u8 mFlags;
+	bool mCursorApp, mKeypadApp;
+	bool mCaps, mNum, mLockChanged;
+	bool mDown[128];
+	u8 mShiftDown[16];
+	u16 mShiftState;
+	u32 mDiacr; // pending diacritic codepoint, 0 = none
+	bool mComposeNext;
+	bool mAsciiActive; // Alt+keypad code composition in progress
+	u32 mAsciiValue;
+	u16 mSyskey, mVc;
+
+	bool lookupChar(u8 table, u16 code, u32 &ch); // unicode keys only
+	int kittyMods(bool locks) const;
+	u32 combineDiacr(u32 ch, char *out); // text output for a text char
+	u32 flushAscii(char *out, u32 size); // emit an Alt+keypad composition
+};
+
+#endif
