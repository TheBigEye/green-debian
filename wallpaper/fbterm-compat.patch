+	osc_buf[osc_len] = 0;
+
+	if (osc_len < 4 || memcmp(osc_buf, "52;", 3)) return;
+
+	s8 *data = strchr(osc_buf + 3, ';');
+	if (!data) return;
+	data++;
+
+	if (!strcmp(data, "?")) {
+		static const s8 hexd[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+		const s8 *sel = appSelection();
+		if (!sel) sel = (const s8 *)"";
+
+		u32 len = strlen(sel);
+		s8 *enc = new s8[(len + 2) / 3 * 4 + 1];
+		u32 i, o = 0;
+		for (i = 0; i < len; i += 3) {
+			u32 v = (u8)sel[i] << 16;
+			u32 n = 1;
+			if (i + 1 < len) { v |= (u8)sel[i + 1] << 8; n = 2; }
+			if (i + 2 < len) { v |= (u8)sel[i + 2]; n = 3; }
+			enc[o++] = hexd[(v >> 18) & 63];
+			enc[o++] = hexd[(v >> 12) & 63];
+			enc[o++] = n > 1 ? hexd[(v >> 6) & 63] : '=';
+			enc[o++] = n > 2 ? hexd[v & 63] : '=';
+		}
+		enc[o] = 0;
+
+		sendBack("\e]52;c;");
+		sendBack(enc);
+		sendBack("\a");
+		delete[] enc;
+		return;
+	}
