+// CSI = flags ; mode u (set), CSI > flags u (push), CSI < n u (pop),
+// CSI ? u (query). Without prefix or '?', CSI u is SCO restore cursor.
+void VTerm::csi_u()
+{
+	KittyState &st = kittyState();
+
+	if (csi_prefix == '=') {
+		u8 mode = (npar >= 1 && param[1]) ? param[1] : 1;
+		u8 flags = param[0] & 31;
+		if (mode == 2) st.flags |= flags;
+		else if (mode == 3) st.flags &= ~flags;
+		else st.flags = flags;
+		kittyChanged();
+	} else if (csi_prefix == '>') {
+		if (st.sp < sizeof(st.stack) / sizeof(st.stack[0]))
+			st.stack[st.sp++] = st.flags;
+		st.flags = param[0] & 31;
+		kittyChanged();
+	} else if (csi_prefix == '<') {
+		u16 n = param[0] ? param[0] : 1;
+		while (n--) {
+			if (!st.sp) { // popping an empty stack resets all flags
+				st.flags = 0;
+				break;
+			}
+			st.flags = st.stack[--st.sp];
+		}
+		kittyChanged();
+	} else if (q_mode) {
+		s8 str[16];
+		snprintf(str, sizeof(str), "\e[?%du", st.flags);
+		sendBack(str);
+	} else {
+		restore_cursor();
+	}
