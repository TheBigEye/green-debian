+// entry). The history buffer is never touched: lines scrolled off
+// inside the alternate screen are lost, like in xterm.
+void VTerm::set_alt_screen(bool enter, bool with_cursor)
+{
+	if (enter == alt_active) return;
+
+	// A pending fast scroll belongs to the screen being left;
+	// dropping it is always safe (everything is redrawn below).
+	pending_scroll = 0;
+
+	if (enter) {
+		if (with_cursor) save_cursor();
+		save_screen();
+
+		for (u16 i = 0; i < max_height; i++) {
+			linenumbers[i] = history_lines + i;
+		}
+		visual_start_line = total_history_lines();
+		scroll_top = 0;
+		scroll_bot = height - 1;
+		alt_active = true;
+		clear_area(0, 0, width - 1, height - 1);
+		move_cursor(0, 0);
+	} else {
+		restore_screen();
+		alt_active = false;
+		scroll_top = 0;
+		scroll_bot = height - 1;
+		if (with_cursor) restore_cursor();
+	}
