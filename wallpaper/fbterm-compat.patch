+// ------------------------------------------------------------------
+// kitty keyboard protocol input: the console is switched to
+// K_MEDIUMRAW and scancodes are translated in userspace (kittykey.cpp)
+// for as long as the active shell has kitty flags set. The keymap
+// behind the encoder is the user's real kernel keymap.
+
+class ConsoleKeymap : public KittyKeymap {
+public:
+	ConsoleKeymap() : mAccentLoaded(false), mAccentCount(0) {}
+
+	bool lookup(u8 table, u16 code, u16 &keysym) override
+	{
+		struct kbentry ke;
+		ke.kb_table = table;
+		ke.kb_index = code;
+		if (ioctl(STDIN_FILENO, KDGKBENT, &ke) == -1) return false;
+		keysym = ke.kb_value;
+		return true;
+	}
+
+	bool accent(u32 diacr, u32 base, u32 &result) override
+	{
+		if (!mAccentLoaded) {
+			mAccentLoaded = true;
+			struct kbdiacrsuc diacrs;
+			memset(&diacrs, 0, sizeof(diacrs));
+			if (ioctl(STDIN_FILENO, KDGKBDIACRUC, &diacrs) == 0) {
+				mAccentCount = diacrs.kb_cnt;
+				if (mAccentCount > 256) mAccentCount = 256;
+				memcpy(mAccent, diacrs.kbdiacruc, sizeof(mAccent));
+			}
+		}
+		for (u32 i = 0; i < mAccentCount; i++) {
+			if (mAccent[i].diacr == diacr && mAccent[i].base == base) {
+				result = mAccent[i].result;
+				return true;
+			}
+		}
+		return false;
+	}
+
+private:
+	bool mAccentLoaded;
+	u32 mAccentCount;
+	struct kbdiacruc mAccent[256];
+};
+
+void TtyInput::setKittyKeyboard(u8 flags)
+{
+	mKittyFlags = flags;
+	applyKittyMode();
+}
+
+void TtyInput::applyKittyMode()
+{
+	if (mRawMode) { // the input-method raw mode owns the console
+		mKittyApplied = false;
+		return;
+	}
+
+	bool want = (mKittyFlags != 0);
+	if (want == mKittyApplied) return;
+
+	if (want) {
+		if (!mKittyEnc) {
+			mKittyKm = new ConsoleKeymap();
+			mKittyEnc = new KittyEncoder(mKittyKm);
+		}
+		ioctl(STDIN_FILENO, KDSKBMODE, K_MEDIUMRAW);
+		mKittyEnc->reset();
+		syncKittyLocks();
+		mKittyShell = 0;
+		mKittyApplied = true;
+	} else {
+		ioctl(STDIN_FILENO, KDSKBMODE, K_UNICODE);
+		mKittyApplied = false;
+		if (mKittyEnc) mKittyEnc->reset();
+	}
+}
+
+void TtyInput::syncKittyLocks()
+{
+	if (!mKittyEnc) return;
+	char leds = 0;
+	if (ioctl(STDIN_FILENO, KDGETLED, &leds) == 0)
+		mKittyEnc->setLocks(leds & LED_CAP, leds & LED_NUM);
+}
+
+void TtyInput::processKittyKeys(s8 *buf, u32 len)
+{
+	FbShell *shell = FbShellManager::instance()->activeShell();
+	if (!shell || !mKittyEnc) return;
+
+	if (shell != mKittyShell) { // do not leak state across shells
+		mKittyShell = shell;
+		mKittyEnc->reset();
+		syncKittyLocks();
+	}
+
+	mKittyEnc->setModes(mKittyFlags, shell->mode(VTerm::CursorKeyEscO),
+			    shell->mode(VTerm::ApplicKeypad));
+
+	for (u32 i = 0; i < len; i++) {
+		bool down = !(buf[i] & 0x80);
+		u16 code = buf[i] & 0x7f;
+
+		if (!code) { // extended scancode (rare two-byte form)
+			if (i + 2 >= len) break;
+			code = (buf[++i] & 0x7f) << 7;
+			code |= buf[++i] & 0x7f;
+			if (!(buf[i] & 0x80) || !(buf[i - 1] & 0x80)) continue;
+		}
+
+		char out[64];
+		u32 n = mKittyEnc->feed(code, down, out, sizeof(out));
+
+		if (u16 syskey = mKittyEnc->takeSyskey())
+			FbTerm::instance()->processSysKey(syskey);
+		if (u16 vc = mKittyEnc->takeVc())
+			ioctl(STDIN_FILENO, VT_ACTIVATE, vc);
+		if (n) shell->keyInput(out, n);
+	}
+
+	if (mKittyEnc->consumeLockChanged()) {
+		char leds = (mKittyEnc->capsLock() ? LED_CAP : 0)
+			| (mKittyEnc->numLock() ? LED_NUM : 0);
+		ioctl(STDIN_FILENO, KDSETLED, leds);
+	}
+}
