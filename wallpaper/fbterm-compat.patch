+// Alternate screen (DECSET 47/1047/1048/1049), as used by vim, less,
+// htop, mc and ncurses (smcup/rmcup): entering saves the main screen
+// and switches to a fresh, cleared one; leaving restores the main
+// screen (and, for 1049/1048, the cursor and rendition saved on
+// entry). The history buffer is never touched: lines scrolled off
+// inside the alternate screen are lost, like in xterm.
+void VTerm::set_alt_screen(bool enter, bool with_cursor)
+{
+	if (enter == alt_active) return;
+
+	// A pending fast scroll belongs to the screen being left;
+	// dropping it is always safe (everything is redrawn below).
+	pending_scroll = 0;
+
+	if (enter) {
+		if (with_cursor) save_cursor();
+		save_screen();
+
+		for (u16 i = 0; i < max_height; i++) {
+			linenumbers[i] = history_lines + i;
+		}
+		visual_start_line = total_history_lines();
+		scroll_top = 0;
+		scroll_bot = height - 1;
+		alt_active = true;
+		clear_area(0, 0, width - 1, height - 1);
+		move_cursor(0, 0);
+	} else {
+		restore_screen();
+		alt_active = false;
+		scroll_top = 0;
+		scroll_bot = height - 1;
+		if (with_cursor) restore_cursor();
+	}
+}
+
+void VTerm::save_screen()
+{
+	delete[] saved_text;
+	delete[] saved_attrs;
+	delete[] saved_linenumbers;
+
+	saved_text = new u16[max_width * max_height];
+	saved_attrs = new CharAttr[max_width * max_height];
+	saved_linenumbers = new u16[max_height];
+	saved_width = max_width;
+	saved_height = max_height;
+
+	memcpy(saved_linenumbers, linenumbers, sizeof(u16) * max_height);
+
+	for (u16 y = 0; y < height; y++) {
+		u32 src = linenumbers[y] * max_width;
+		u32 dst = y * max_width;
+		memcpy(&saved_text[dst], &text[src], sizeof(u16) * width);
+		memcpy(&saved_attrs[dst], &attrs[src], sizeof(CharAttr) * width);
+		for (u16 x = width; x < max_width; x++) {
+			saved_text[dst + x] = ' ';
+			saved_attrs[dst + x] = default_char_attr;
+		}
+	}
+}
+
+void VTerm::restore_screen()
+{
+	if (!saved_text || !saved_linenumbers) return;
+
+	u16 copy_lines = (height < saved_height) ? height : saved_height;
+	u16 copy_width = (width < saved_width) ? width : saved_width;
+	u16 copy_map = (max_height < saved_height) ? max_height : saved_height;
+
+	memcpy(linenumbers, saved_linenumbers, sizeof(u16) * copy_map);
+	for (u16 i = copy_map; i < max_height; i++) {
+		linenumbers[i] = history_lines + i;
+	}
+
+	// Blank everything first: rows or columns the terminal grew
+	// while in the alternate screen start out empty.
+	clear_area(0, 0, width - 1, height - 1);
+
+	for (u16 y = 0; y < copy_lines; y++) {
+		u32 dst = linenumbers[y] * max_width;
+		u32 src = y * saved_width;
+		memcpy(&text[dst], &saved_text[src], sizeof(u16) * copy_width);
+		memcpy(&attrs[dst], &saved_attrs[src], sizeof(CharAttr) * copy_width);
+		changed_line(y, 0, width - 1);
+	}
+}
